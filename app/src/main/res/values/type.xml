<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
    ═══════════════════════════════════════════════════════════════
      CLAY TYPOGRAPHY SYSTEM
      Font family: Inter (via Google Fonts downloadable font).
      Falls back to sans-serif on devices without GMS font provider.
      Scale follows the Claymorphism premium UI hierarchy.
    ═══════════════════════════════════════════════════════════════
    -->

    <!-- Headline Large: main screen titles — 28sp bold -->
    <style name="TextAppearance.Clay.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Headline Medium: section headings — 24sp semi-bold -->
    <style name="TextAppearance.Clay.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="fontWeight">600</item>
    </style>

    <!-- Title Large: card and feature titles — 20sp semi-bold -->
    <style name="TextAppearance.Clay.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="fontWeight">600</item>
    </style>

    <!-- Title Medium: sub-headings and card labels — 17sp semi-bold -->
    <style name="TextAppearance.Clay.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="fontWeight">600</item>
    </style>

    <!-- Body Large: primary body text — 16sp regular, 24sp line height -->
    <style name="TextAppearance.Clay.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="lineHeight">24sp</item>
    </style>

    <!-- Body Medium: secondary body text — 14sp regular, 20sp line height -->
    <style name="TextAppearance.Clay.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="lineHeight">20sp</item>
    </style>

    <!-- Label Large: button text, chips, tabs — 14sp medium weight -->
    <style name="TextAppearance.Clay.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="fontWeight">500</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Label Medium: captions and helper text — 12sp medium weight -->
    <style name="TextAppearance.Clay.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="fontWeight">500</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Number Display: large stat numbers — 32sp bold -->
    <style name="TextAppearance.Clay.NumberDisplay" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>

</resources>
