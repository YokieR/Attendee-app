<?xml version="1.0" encoding="utf-8"?>
<!--
  Clay bottom nav background: shadow layer underneath, then surface fill
  with top corners rounded (28dp) and bottom corners squared.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Upward shadow layer -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <solid android:color="#1A1A2E1A" />
        </shape>
    </item>

    <!-- Surface fill layer -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <solid android:color="@color/clay_surface" />
        </shape>
    </item>

</layer-list>
