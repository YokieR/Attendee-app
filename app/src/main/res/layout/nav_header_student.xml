<?xml version="1.0" encoding="utf-8"?>
<!--
  Drawer header — Student
  Deep forest green gradient → gold bottom divider line
  Layout: avatar left, name + reg number below it
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_brand_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:paddingTop="32dp"
        android:gravity="center_vertical">

        <!-- Avatar with gold border ring -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivStudentProfile"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person_outlined"
            android:background="@color/BrandPrimaryLight"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            app:strokeColor="@color/BrandAccent"
            app:strokeWidth="2.5dp" />

        <!-- Name + Reg No -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderRegNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="REG/000/2026"
                android:textColor="@color/white_alpha_80"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- DeKUT Gold divider line at bottom of drawer header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/BrandAccent" />

</LinearLayout>
