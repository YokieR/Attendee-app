<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Clay.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Unit Code & Unit Name -->
            <TextView
                android:id="@+id/tvHistoryCourseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CIT 4101 · Database Systems"
                android:textColor="@color/clay_on_surface"
                android:textAppearance="@style/TextAppearance.Clay.TitleMedium" />

            <!-- Lecturer Name & Venue -->
            <TextView
                android:id="@+id/tvHistoryLecturer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Dr. John Doe · Room 102"
                android:textColor="@color/clay_on_surface_variant"
                android:textAppearance="@style/TextAppearance.Clay.BodyMedium" />

            <!-- Date & Time row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_history_outlined"
                    android:contentDescription="Date"
                    app:tint="@color/clay_on_surface_variant" />

                <TextView
                    android:id="@+id/tvHistoryDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Monday, 16 Oct 2026"
                    android:textColor="@color/clay_on_surface_variant"
                    android:textAppearance="@style/TextAppearance.Clay.LabelMedium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:text="•"
                    android:textColor="@color/clay_on_surface_variant" />

                <TextView
                    android:id="@+id/tvHistoryTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="08:42 AM"
                    android:textColor="@color/clay_on_surface_variant"
                    android:textAppearance="@style/TextAppearance.Clay.LabelMedium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status badge chip: Present=success, Absent=error, Late/pending=warning -->
        <TextView
            android:id="@+id/tvHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/clay_chip_background"
            android:backgroundTint="@color/clay_success_container"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="PRESENT"
            android:textColor="@color/clay_success"
            android:textAppearance="@style/TextAppearance.Clay.LabelMedium"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
