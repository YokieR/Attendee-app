<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clay_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <!-- Welcome header with student name (TextAppearance.Clay.HeadlineLarge) -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good Morning,"
                android:textColor="@color/clay_on_surface_variant"
                android:textAppearance="@style/TextAppearance.Clay.BodyLarge" />

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Student Name"
                android:textColor="@color/clay_on_surface"
                android:textAppearance="@style/TextAppearance.Clay.HeadlineLarge" />

            <TextView
                android:id="@+id/tvRegNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="REG/2023/001"
                android:textColor="@color/clay_on_surface_variant"
                android:textAppearance="@style/TextAppearance.Clay.BodyMedium" />

            <!-- Attendance Summary Card (clay stat card) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAttendanceSummary"
                style="@style/Widget.Clay.StatCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Attendance"
                        android:textColor="@color/clay_on_surface_variant"
                        android:textAppearance="@style/TextAppearance.Clay.TitleMedium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Attendance percentage: TextAppearance.Clay.NumberDisplay -->
                        <TextView
                            android:id="@+id/tvOverallPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/clay_primary"
                            android:textAppearance="@style/TextAppearance.Clay.NumberDisplay" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="20dp"
                            android:background="@color/clay_outline" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAttendedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Attended: 0"
                                android:textColor="@color/clay_on_surface"
                                android:textAppearance="@style/TextAppearance.Clay.BodyMedium" />

                            <TextView
                                android:id="@+id/tvMissedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Missed: 0"
                                android:textColor="@color/clay_on_surface"
                                android:textAppearance="@style/TextAppearance.Clay.BodyMedium" />

                            <TextView
                                android:id="@+id/tvFlaggedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Flagged: 0"
                                android:textColor="@color/clay_error"
                                android:textAppearance="@style/TextAppearance.Clay.BodyMedium" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active Session Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Current Session"
                android:textColor="@color/clay_on_surface"
                android:textAppearance="@style/TextAppearance.Clay.TitleLarge" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveSession"
                style="@style/Widget.Clay.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:strokeColor="@color/clay_primary"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:id="@+id/layoutActiveSessionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Clay.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE ATTENDANCE"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:id="@+id/tvActiveCourseName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Course Name"
                        android:textColor="@color/clay_on_surface"
                        android:textAppearance="@style/TextAppearance.Clay.TitleLarge" />

                    <TextView
                        android:id="@+id/tvActiveCourseCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CIT 4101"
                        android:textColor="@color/clay_on_surface_variant"
                        android:textAppearance="@style/TextAppearance.Clay.BodyMedium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lecturer:"
                                android:textColor="@color/clay_on_surface_variant"
                                android:textAppearance="@style/TextAppearance.Clay.LabelMedium" />

                            <TextView
                                android:id="@+id/tvActiveLecturer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lecturer Name"
                                android:textColor="@color/clay_on_surface"
                                android:textAppearance="@style/TextAppearance.Clay.BodyMedium" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Venue:"
                                android:textColor="@color/clay_on_surface_variant"
                                android:textAppearance="@style/TextAppearance.Clay.LabelMedium" />

                            <TextView
                                android:id="@+id/tvActiveVenue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Venue Name"
                                android:textColor="@color/clay_on_surface"
                                android:textAppearance="@style/TextAppearance.Clay.BodyMedium" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvActiveTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="08:00 AM - 10:00 AM"
                        android:textColor="@color/clay_on_surface_variant"
                        android:textAppearance="@style/TextAppearance.Clay.BodyMedium"
                        android:textStyle="bold" />

                    <!-- Primary action button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMarkAttendance"
                        style="@style/Widget.Clay.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp"
                        android:text="MARK ATTENDANCE" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoActiveSession"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:gravity="center"
                    android:text="No Active Attendance Session"
                    android:textColor="@color/clay_on_surface_variant"
                    android:textAppearance="@style/TextAppearance.Clay.BodyMedium"
                    android:visibility="gone" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Recent Attendance Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Attendance"
                    android:textColor="@color/clay_on_surface"
                    android:textAppearance="@style/TextAppearance.Clay.TitleLarge" />

                <TextView
                    android:id="@+id/tvViewHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="VIEW HISTORY"
                    android:textColor="@color/clay_primary"
                    android:textAppearance="@style/TextAppearance.Clay.LabelMedium"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Recent attendance list (clay card items) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentAttendance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_attendance_history" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
